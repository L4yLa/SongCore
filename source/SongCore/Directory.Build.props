<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>

  <PropertyGroup>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GenerateManifest>true</GenerateManifest>
    <BaseManifestPath>manifest.json</BaseManifestPath>
    <!-- No automatic copy into the game folder, like the other mods in this project. -->
    <DisableCopyToGame>true</DisableCopyToGame>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DisableZipRelease>true</DisableZipRelease>
  </PropertyGroup>

  <!-- Overriding default csproj property values which would otherwise interfere with the manifest regeneration. -->
  <PropertyGroup>
    <Authors>L4yLa_Coop</Authors>
    <Version>3.16.43</Version>
  </PropertyGroup>

</Project>